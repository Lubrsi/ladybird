(module
  (import "env" "compile" (func $compile))

  (global $iterations (mut i32) (i32.const 0))

  (func (export "run") (result i32)
    ;; Keep ten read-only locals ahead of the loop counter in the bounded promotion order, then
    ;; make the function large enough to use selective promotion. The loop counter consequently
    ;; exercises the unpromoted native-local representation on both OSR and fresh native entry.
    (local $stable0 i32)
    (local $stable1 i32)
    (local $stable2 i32)
    (local $stable3 i32)
    (local $stable4 i32)
    (local $stable5 i32)
    (local $stable6 i32)
    (local $stable7 i32)
    (local $stable8 i32)
    (local $stable9 i32)
    (local $iteration i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)

    (call $compile)

    (drop (local.get $stable0))
    (drop (local.get $stable1))
    (drop (local.get $stable2))
    (drop (local.get $stable3))
    (drop (local.get $stable4))
    (drop (local.get $stable5))
    (drop (local.get $stable6))
    (drop (local.get $stable7))
    (drop (local.get $stable8))
    (drop (local.get $stable9))

    (loop $loop
      (global.set $iterations (i32.add (global.get $iterations) (i32.const 1)))
      (local.set $iteration (i32.add (local.get $iteration) (i32.const 1)))
      (br_if $loop (i32.lt_u (local.get $iteration) (i32.const 3))))

    (global.get $iterations))

  ;; The first ten stable parameters win the bounded promotion order. The final parameter remains
  ;; in native payload storage, covering both interpreter-adapter and direct native entry.
  (func $native_unpromoted (export "native_unpromoted")
    (param $stable0 i32)
    (param $stable1 i32)
    (param $stable2 i32)
    (param $stable3 i32)
    (param $stable4 i32)
    (param $stable5 i32)
    (param $stable6 i32)
    (param $stable7 i32)
    (param $stable8 i32)
    (param $stable9 i32)
    (param $value i32)
    (result i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)

    (drop (local.get $stable0))
    (drop (local.get $stable1))
    (drop (local.get $stable2))
    (drop (local.get $stable3))
    (drop (local.get $stable4))
    (drop (local.get $stable5))
    (drop (local.get $stable6))
    (drop (local.get $stable7))
    (drop (local.get $stable8))
    (drop (local.get $stable9))
    (local.set $value (i32.add (local.get $value) (i32.const 1)))
    (local.get $value))

  ;; Keep all four numeric parameters outside the promotion budget while remaining below the
  ;; typed native ABI's parameter limit.
  (func $native_typed_unpromoted (export "native_typed_unpromoted")
    (param $i i32)
    (param $l i64)
    (param $f f32)
    (param $d f64)
    (result f64)
    (local $stable0 i32)
    (local $stable1 i32)
    (local $stable2 i32)
    (local $stable3 i32)
    (local $stable4 i32)
    (local $stable5 i32)
    (local $stable6 i32)
    (local $stable7 i32)
    (local $stable8 i32)
    (local $stable9 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)
    (local i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)

    (drop (local.get $stable0))
    (drop (local.get $stable1))
    (drop (local.get $stable2))
    (drop (local.get $stable3))
    (drop (local.get $stable4))
    (drop (local.get $stable5))
    (drop (local.get $stable6))
    (drop (local.get $stable7))
    (drop (local.get $stable8))
    (drop (local.get $stable9))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (local.set $l (i64.add (local.get $l) (i64.const 2)))
    (local.set $f (f32.add (local.get $f) (f32.const 3)))
    (local.set $d (f64.add (local.get $d) (f64.const 4)))
    (f64.add
      (f64.add
        (f64.convert_i32_s (local.get $i))
        (f64.convert_i64_s (local.get $l)))
      (f64.add
        (f64.promote_f32 (local.get $f))
        (local.get $d))))

  (func (export "direct_unpromoted") (result i32)
    (call $native_unpromoted
      (i32.const 1)
      (i32.const 2)
      (i32.const 3)
      (i32.const 4)
      (i32.const 5)
      (i32.const 6)
      (i32.const 7)
      (i32.const 8)
      (i32.const 9)
      (i32.const 10)
      (i32.const 11)))

  (func (export "direct_typed_unpromoted") (result f64)
    (call $native_typed_unpromoted
      (i32.const 1)
      (i64.const 2)
      (f32.const 3.5)
      (f64.const 4.25)))
)
